  "components": {
    "schemas": {
      "AnswerIn": {
        "properties": {
          "answer": {
            "type": "string",
            "title": "Answer",
            "description": "Text for short answers; A\u2013D for mc; t/f for tf"
          }
        },
        "type": "object",
        "required": [
          "answer"
        ],
        "title": "AnswerIn"
      },
      "AnswerOut": {
        "properties": {
          "question_id": {
