                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Correct"
          },
          "correct_option": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Correct Option"
          },
          "feedback": {
            "type": "string",
            "title": "Feedback"
          },
          "missing": {
            "type": "string",
            "title": "Missing"
          },
          "reference_answer": {
            "type": "string",
            "title": "Reference Answer"
          },
          "explanation": {
            "type": "string",
            "title": "Explanation"
          },
          "mastery_before": {
            "type": "number",
            "title": "Mastery Before"
          },
          "mastery_after": {
            "type": "number",
            "title": "Mastery After"
          }
        },
        "type": "object",
        "required": [
          "question_id",
          "point",
          "score",
          "correct",
          "correct_option",
          "feedback",
          "missing",
          "reference_answer",
          "explanation",
          "mastery_before",
          "mastery_after"
        ],
        "title": "AnswerOut"
      },
      "ChangeOut": {
        "properties": {
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "path": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Path"
          },
          "previous_path": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Previous Path"
          }
        },
        "type": "object",
        "required": [
          "kind",
          "path"
        ],
        "title": "ChangeOut"
      },
      "CreatedWorkspaceOut": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "path": {
            "type": "string",
            "title": "Path"
          },
          "notion_page_id": {
            "type": "string",
            "title": "Notion Page Id"
          },
          "is_default": {
            "type": "boolean",
            "title": "Is Default"
          },
          "found": {
            "type": "boolean",
            "title": "Found"
          },
          "notion_title": {
            "type": "string",
            "title": "Notion Title"
          }
        },
        "type": "object",
        "required": [
          "name",
          "path",
          "notion_page_id",
          "is_default",
          "found",
          "notion_title"
        ],
        "title": "CreatedWorkspaceOut"
      },
      "FailedNoteOut": {
        "properties": {
